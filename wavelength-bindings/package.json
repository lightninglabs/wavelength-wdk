{
  "name": "wavelength-bindings",
  "version": "0.1.0",
  "private": true,
  "description": "Wavelength binding layer for wdk-wallet-wavelength: iOS native addon, Android TurboModule, desktop WASM host, and the platform-dispatch transport.",
  "type": "module",
  "main": "src/wavelength-transport-bare-unsupported.js",
  "scripts": {
    "lint": "standard --env jest",
    "lint:fix": "standard --fix --env jest",
    "typecheck": "tsc",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=integration",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration --testTimeout=60000",
    "test:all": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=60000",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathIgnorePatterns=integration"
  },
  "codegenConfig": {
    "name": "WavelengthSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "engineering.lightning.wavelength.reactnative"
    }
  },
  "exports": {
    ".": {
      "pear": "./src/wavelength-transport-bare-native.js",
      "ios": "./src/wavelength-transport-bare-native.js",
      "android": "./src/wavelength-transport-bare-android.js",
      "darwin": "./src/wavelength-transport-bare-wasm.js",
      "linux": "./src/wavelength-transport-bare-wasm.js",
      "win32": "./src/wavelength-transport-bare-wasm.js",
      "bare": "./src/wavelength-transport-bare-unsupported.js",
      "default": "./src/wavelength-transport-bare-unsupported.js"
    },
    "./android/ipc-framing": "./src/android/ipc-framing.js",
    "./native": "./src/NativeWavelength.ts",
    "./package": "./package.json",
    "./app.plugin.cjs": "./app.plugin.cjs"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@lightninglabs/wavelength-core": "0.1.2-rc4",
    "b4a": "^1.6.7",
    "bare-fs": "^4.2.3",
    "bare-module": "^6.4.0",
    "bare-node-runtime": "^1.5.0",
    "bare-path": "^3.1.1",
    "bare-thread": "^1.2.4",
    "bare-worker": "^4.0.0",
    "wavelength-bare-addon": "file:./ios"
  },
  "devDependencies": {
    "bare-make": "^1.8.0",
    "cmake-bare": "^1.8.0",
    "cmake-npm": "^1.1.2",
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "standard": "17.1.2",
    "typescript": "5.9.3"
  },
  "standard": {
    "ignore": [
      "tests/**/*.js"
    ],
    "globals": [
      "Bare",
      "BareKit"
    ]
  }
}
