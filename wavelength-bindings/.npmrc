# react/react-native are wildcard peerDependencies (see package.json) --
# they're provided by whichever app consumes this package (via its own
# node_modules), never installed by this package itself. Without this,
# `npm install` run standalone inside this directory (e.g. for its own test
# suite) auto-installs npm's *latest* react-native as a real dependency here,
# creating a second, different-versioned react-native copy alongside the
# consuming app's real one -- which Metro then also picks up, causing
# codegen/bundling failures from two react-native trees at once.
# (auto-install-peers=false alone no longer suppresses this on npm 11 --
# confirmed by testing; legacy-peer-deps is the setting that actually works.)
legacy-peer-deps=true
