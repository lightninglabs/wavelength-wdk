{
  "name": "@lightninglabs/wdk-wallet-wavelength",
  "version": "0.2.0-rc1",
  "description": "A simple package to manage Wavelength (self-custodial Lightning/Ark) wallets.",
  "keywords": [
    "wdk",
    "wallet",
    "wavelength",
    "lightning",
    "ark"
  ],
  "author": "Lightning Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightninglabs/wavelength-wdk.git",
    "directory": "wdk-wallet-wavelength"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "files": [
    "index.js",
    "bare.js",
    "pear.js",
    "app.plugin.cjs",
    "src",
    "!src/transports/wasm/.worker-scratch",
    "types",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/fetch-aar.cjs",
    "fetch-aar": "node scripts/fetch-aar.cjs",
    "build:types": "rimraf types; tsc",
    "typecheck": "tsc --noEmit",
    "fetch:wasm-runtime": "bash scripts/fetch-wasm-runtime.sh",
    "lint": "standard --env jest",
    "lint:fix": "standard --fix --env jest",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=integration",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration --testTimeout=60000",
    "test:all": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=60000",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathIgnorePatterns=integration"
  },
  "dependencies": {
    "@lightninglabs/wavelength-bare-addon": "0.2.0-rc1",
    "@lightninglabs/wavelength-core": "0.2.0-rc1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "2.2.0",
    "@scure/bip32": "1.7.0",
    "@tetherto/wdk-wallet": "^1.0.0-beta.16",
    "b4a": "^1.6.7",
    "bare-fs": "^4.2.3",
    "bare-module": "^6.4.0",
    "bare-node-runtime": "^1.5.0",
    "bare-path": "^3.1.1",
    "bare-thread": "^1.2.4",
    "bare-worker": "^4.0.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "rimraf": "6.1.3",
    "standard": "17.1.2",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "pear": "./pear.js",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./native": "./src/transports/wavelength-native-module.js",
    "./android/ipc-framing": "./src/transports/android/ipc-framing.js",
    "./app.plugin.cjs": "./app.plugin.cjs",
    "./package": {
      "default": "./package.json"
    }
  },
  "imports": {
    "#transport": {
      "pear": "./src/transports/wavelength-transport-bare-native.js",
      "ios": "./src/transports/wavelength-transport-bare-native.js",
      "android": "./src/transports/wavelength-transport-bare-android.js",
      "darwin": "./src/transports/wavelength-transport-bare-wasm.js",
      "linux": "./src/transports/wavelength-transport-bare-wasm.js",
      "win32": "./src/transports/wavelength-transport-bare-wasm.js",
      "bare": "./src/transports/wavelength-transport-bare-unsupported.js",
      "default": "./src/transports/wavelength-transport-bare-unsupported.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "pear.js",
      "tests/**/*.js"
    ],
    "globals": [
      "Bare",
      "BareKit"
    ]
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
